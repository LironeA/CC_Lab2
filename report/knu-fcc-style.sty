  \def\KNU@title@university{Київський національний університет\\імені Тараса Шевченка}%
  \def\KNU@title@faculty{Факультет комп'ютерних наук та кібернетики}%
  \def\KNU@title@department{}%
  \def\KNU@title@type{}%
  \def\KNU@title@degree{}%
  \def\KNU@title@specialty{}%
  \def\KNU@title@program{}%
  \def\KNU@title@titleLabel{на тему:}%
  \def\KNU@title@title{}%
  \def\KNU@title@studentInfo{}%
  \def\KNU@title@student{}%
  \def\KNU@title@studentSignature{true}%
  \def\KNU@title@supervisorInfo{}%
  \def\KNU@title@supervisor{}%
  \def\KNU@title@supervisorSignature{true}%
  \def\KNU@title@declaration{}%
  \def\KNU@title@declarationSigner{Студент}%
  \def\KNU@title@admission{}%
