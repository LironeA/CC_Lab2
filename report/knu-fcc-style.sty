\newcommand{\KNU@SignatureBox}{%
  \begin{minipage}[t]{0.23\textwidth}
    \centering
    \vspace{\baselineskip}
    \rule{0.9\linewidth}{0.4pt}\\[-0.2ex]
    {\footnotesize(підпис)}
  \end{minipage}%
}

\newcommand{\KNU@TitlePersonBlock}[2]{%
  \noindent
  \begin{minipage}[t]{0.68\textwidth}
    \raggedright
    #1
  \end{minipage}%
  \ifdefstring{#2}{false}{}{\hfill\KNU@SignatureBox}\par
}

\newcommand{\KNUTitlePageMake}[1][]{%
  \KNU@title@defaults
  \setkeys{KNUTitle}{#1}%
  \clearpage
  \thispagestyle{empty}%
  \begingroup
    \begin{center}
      \ifx\KNU@title@ministry\@empty\else\KNU@title@ministry\\\fi
      \parbox{0.95\textwidth}{%
        \centering\bfseries\MakeTextUppercase{\KNU@title@university}\par
      }\\
      \KNU@title@faculty
      \ifx\KNU@title@department\@empty\else\\\KNU@title@department\fi
    \end{center}

    \vspace{2\baselineskip}

    \begin{center}
      \ifx\KNU@title@type\@empty\else\textbf{\KNU@title@type}\\\fi
      \ifx\KNU@title@degree\@empty\else на здобуття ступеня \KNU@title@degree\\\fi
      \ifx\KNU@title@specialty\@empty\else за спеціальністю \KNU@title@specialty\\\fi
      \ifx\KNU@title@program\@empty\else ОПП \KNU@title@program\\\fi
      \ifx\KNU@title@title\@empty\else \KNU@title@titleLabel\\[0.5\baselineskip]\textbf{\MakeTextUppercase{\KNU@title@title}}\fi
    \end{center}

    \vspace{2\baselineskip}

    \ifx\KNU@title@studentInfo\@empty\else
      \KNU@TitlePersonBlock{%
        \KNU@title@studentInfo\par
        \ifx\KNU@title@student\@empty\else\textbf{\KNU@title@student}\par\fi
      }{\KNU@title@studentSignature}
    \fi

    \ifx\KNU@title@supervisorInfo\@empty\else
      \vspace{\baselineskip}
      \KNU@TitlePersonBlock{%
        \KNU@title@supervisorInfo\par
        \ifx\KNU@title@supervisor\@empty\else\textbf{\KNU@title@supervisor}\par\fi
      }{\KNU@title@supervisorSignature}
    \fi

    \ifx\KNU@title@declaration\@empty\else
      \vspace{\baselineskip}
      \KNU@TitlePersonBlock{%
        \hfill\begin{minipage}[t]{0.72\linewidth}
          \raggedright
          \KNU@title@declaration\par
          \KNU@title@declarationSigner
        \end{minipage}
      }{true}
    \fi

    \ifx\KNU@title@admission\@empty\else
      \vspace{\baselineskip}
      \KNU@TitlePersonBlock{%
        \KNU@title@admission\par
        \ifx\KNU@title@headOfDepartment\@empty\else\KNU@title@headOfDepartment\par\fi
      }{true}
    \fi

    \vfill

    \begin{center}
      \MakeTextUppercase{\KNU@title@city}\ \KNU@title@year
    \end{center}
    \par
  \endgroup
  \clearpage
}
\makeatother

\newenvironment{KNUExample}{%
  \par\vspace{2\baselineskip}%
