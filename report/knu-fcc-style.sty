\define@key{KNUTitle}{university}{\def\KNU@title@university{#1}}
\define@key{KNUTitle}{faculty}{\def\KNU@title@faculty{#1}}
\define@key{KNUTitle}{department}{\def\KNU@title@department{#1}}
\define@key{KNUTitle}{type}{\def\KNU@title@type{#1}}
\define@key{KNUTitle}{degree}{\def\KNU@title@degree{#1}}
\define@key{KNUTitle}{specialty}{\def\KNU@title@specialty{#1}}
\define@key{KNUTitle}{program}{\def\KNU@title@program{#1}}
\define@key{KNUTitle}{titleLabel}{\def\KNU@title@titleLabel{#1}}
\define@key{KNUTitle}{title}{\def\KNU@title@title{#1}}
\define@key{KNUTitle}{studentInfo}{\def\KNU@title@studentInfo{#1}}
\define@key{KNUTitle}{student}{\def\KNU@title@student{#1}}
\define@key{KNUTitle}{studentSignature}{\def\KNU@title@studentSignature{#1}}
