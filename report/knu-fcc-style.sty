}{%
  \par\vspace{2\baselineskip}%
}

\newcommand{\KNUKeywords}[1]{%
  \noindent\textbf{Ключові слова:} #1\par
}


% -----------------------------------------------------------------------------
% Work statistics for abstract (pages, figures, tables, appendices, sources)
% -----------------------------------------------------------------------------
\newcounter{KNUFigureTotal}
\newcounter{KNUTableTotal}
\newcounter{KNUAppendixTotal}
\newcounter{KNUSourceTotal}
\regtotcounter{KNUFigureTotal}
\regtotcounter{KNUTableTotal}
\regtotcounter{KNUAppendixTotal}
\regtotcounter{KNUSourceTotal}

\makeatletter
\newif\ifKNU@inappendix
\KNU@inappendixfalse

\pretocmd{\figure}{\stepcounter{KNUFigureTotal}}{}{}
\pretocmd{\KNU@table@here}{\stepcounter{KNUTableTotal}}{}{}

\let\KNU@origappendix\appendix
\renewcommand{\appendix}{%
  \KNU@inappendixtrue
  \KNU@origappendix
}

\let\KNU@origsection\section
\renewcommand{\section}{%
  \ifKNU@inappendix
    \stepcounter{KNUAppendixTotal}%
  \fi
  \KNU@origsection
}

\let\KNU@origbibitem\bibitem
\renewcommand{\bibitem}{%
  \stepcounter{KNUSourceTotal}%
  \KNU@origbibitem
}
\makeatother

\newcommand{\KNUWorkStats}{%
  \pageref{LastPage}~с., \total{KNUFigureTotal}~рис., \total{KNUTableTotal}~табл., \total{KNUAppendixTotal}~дод., \total{KNUSourceTotal}~джерела.
}
% -----------------------------------------------------------------------------
% Recommended class warning
