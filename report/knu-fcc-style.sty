\makeatletter
\AtBeginDocument{%
  \@ifundefined{captionsukrainian}{}{%
    \gappto\captionsukrainian{%
      \renewcommand{\contentsname}{ЗМІСТ}%
      \renewcommand{\refname}{ПЕРЕЛІК ДЖЕРЕЛ ПОСИЛАННЯ}%
    }%
  }%
  \renewcommand{\contentsname}{ЗМІСТ}%
  \renewcommand{\refname}{ПЕРЕЛІК ДЖЕРЕЛ ПОСИЛАННЯ}%
  \pdfstringdefDisableCommands{\def\MakeTextUppercase#1{#1}}%
  \@ifclassloaded{extarticle}{}{%
    \PackageWarningNoLine{knu-fcc-style}{Recommended document class: \string\documentclass[14pt]{extarticle}}%
  }%
}
\makeatother

