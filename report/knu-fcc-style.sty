%% knu-fcc-style.sty
%% LaTeX style for reports / course papers according to
%% Faculty of Computer Science and Cybernetics,
%% Taras Shevchenko National University of Kyiv guidelines.
%%
%% Recommended usage:
%%   \documentclass[14pt]{extarticle}
%%   \usepackage{knu-fcc-style}
%%   Compile with XeLaTeX or LuaLaTeX.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{knu-fcc-style}[2026/05/03 KNU FCC document style]

% -----------------------------------------------------------------------------
% Engine and language setup
% -----------------------------------------------------------------------------
\RequirePackage{iftex}

\ifPDFTeX
  \RequirePackage[T2A]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[ukrainian]{babel}
  \DeclareUnicodeCharacter{2265}{$\ge$}
  \DeclareUnicodeCharacter{2264}{$\le$}
  \DeclareUnicodeCharacter{2192}{$\rightarrow$}
  \DeclareUnicodeCharacter{2014}{---}
  \DeclareUnicodeCharacter{2018}{`}
  \DeclareUnicodeCharacter{2019}{'}
  \DeclareUnicodeCharacter{201C}{``}
  \DeclareUnicodeCharacter{201D}{''}
  \DeclareUnicodeCharacter{00A0}{~}
  \PackageWarningNoLine{knu-fcc-style}{For closest compliance with Times New Roman, compile with XeLaTeX or LuaLaTeX}
\else
  \RequirePackage{fontspec}
  \RequirePackage{polyglossia}
  \setdefaultlanguage{ukrainian}
  \IfFontExistsTF{Times New Roman}{%
    \setmainfont{Times New Roman}
  }{%
    \IfFontExistsTF{Tinos}{%
      \setmainfont{Tinos}
      \PackageWarningNoLine{knu-fcc-style}{Times New Roman not found; using Tinos as a metrically compatible fallback}%
    }{%
      \IfFontExistsTF{TeXGyreTermesX-Regular.otf}{%
        \setmainfont{TeXGyreTermesX}[
          Extension=.otf,
          UprightFont=*-Regular,
          BoldFont=*-Bold,
          ItalicFont=*-Italic,
          BoldItalicFont=*-BoldItalic
        ]%
        \PackageWarningNoLine{knu-fcc-style}{Times New Roman not found; using TeX Gyre Termes X as a fallback}%
      }{%
        \setmainfont{Latin Modern Roman}%
        \PackageWarningNoLine{knu-fcc-style}{Times New Roman not found; using Latin Modern Roman as a fallback}%
      }%
    }%
  }%
  \IfFontExistsTF{Tinos}{%
    \newfontfamily\cyrillicfont{Tinos}[Script=Cyrillic]
  }{%
    \IfFontExistsTF{FreeSerif}{%
      \newfontfamily\cyrillicfont{FreeSerif}[Script=Cyrillic]
    }{%
      \IfFontExistsTF{Times New Roman}{%
        \newfontfamily\cyrillicfont{Times New Roman}[Script=Cyrillic]
      }{%
        \IfFontExistsTF{TeXGyreTermesX-Regular.otf}{%
          \newfontfamily\cyrillicfont{TeXGyreTermesX}[
            Script=Cyrillic,
            Extension=.otf,
            UprightFont=*-Regular,
            BoldFont=*-Bold,
            ItalicFont=*-Italic,
            BoldItalicFont=*-BoldItalic
          ]
        }{%
          \newfontfamily\cyrillicfont{CMU Serif}[Script=Cyrillic]
        }%
      }%
    }%
  }%
  \IfFontExistsTF{Consolas}{%
    \setmonofont{Consolas}
    \newfontfamily\cyrillicfonttt{Consolas}[Script=Cyrillic]
  }{%
    \IfFontExistsTF{DejaVu Sans Mono}{%
      \setmonofont{DejaVu Sans Mono}
      \newfontfamily\cyrillicfonttt{DejaVu Sans Mono}[Script=Cyrillic]
    }{%
      \IfFontExistsTF{Courier New}{%
        \setmonofont{Courier New}
        \newfontfamily\cyrillicfonttt{Courier New}[Script=Cyrillic]
      }{%
        \setmonofont{Latin Modern Mono}
      }%
    }%
  }
\fi

\RequirePackage{csquotes}

% -----------------------------------------------------------------------------
% Page layout: A4, margins, paragraph indentation, spacing
% -----------------------------------------------------------------------------
\RequirePackage[
  a4paper,
  top=20mm,
  bottom=20mm,
  left=25mm,
  right=10mm,
  includehead=false
]{geometry}

\RequirePackage{setspace}
\RequirePackage{indentfirst}

\onehalfspacing
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{3em}

% -----------------------------------------------------------------------------
% Page numbering: top right; title page should use \thispagestyle{empty}
% -----------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{17pt}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\newcommand{\KNUHidePageNumber}{\thispagestyle{empty}}

% -----------------------------------------------------------------------------
% Section headings
% - structural parts and sections: new page, centered, bold, uppercase
% - subsections and lower levels: paragraph indent, bold, no final dot
% -----------------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{etoolbox}
\RequirePackage{textcase}

\titleformat{\section}[block]
  {\normalfont\normalsize\bfseries\centering}
  {\thesection}
  {1em}
  {\MakeTextUppercase}

\titleformat{name=\section,numberless}[block]
  {\normalfont\normalsize\bfseries\centering}
  {}
  {0pt}
  {\MakeTextUppercase}

\titlespacing*{\section}
  {0pt}
  {0pt}
  {2\baselineskip}

\titleformat{\subsection}[block]
  {\normalfont\normalsize\bfseries}
  {\thesubsection}
  {1em}
  {}

\titlespacing*{\subsection}
  {\parindent}
  {2\baselineskip}
  {2\baselineskip}

\titleformat{\subsubsection}[block]
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}
  {1em}
  {}

\titlespacing*{\subsubsection}
  {\parindent}
  {2\baselineskip}
  {2\baselineskip}

\titleformat{\paragraph}[block]
  {\normalfont\normalsize\bfseries}
  {\theparagraph}
  {1em}
  {}

\titlespacing*{\paragraph}
  {\parindent}
  {2\baselineskip}
  {2\baselineskip}

\titleformat{\subparagraph}[block]
  {\normalfont\normalsize\bfseries}
  {\thesubparagraph}
  {1em}
  {}

\titlespacing*{\subparagraph}
  {\parindent}
  {2\baselineskip}
  {2\baselineskip}

% Every section/structural part starts on a new page.
\pretocmd{\section}{\clearpage}{}{}
\newcommand{\KNUContents}{\clearpage\tableofcontents}

% Helper for unnumbered structural parts that should appear in the table of contents.
\newcommand{\KNUUnnumberedSection}[1]{%
  \section*{#1}%
  \addcontentsline{toc}{section}{\MakeTextUppercase{#1}}%
}

% Ukrainian appendix section letters for reports that need appendix labels
% "А", "Б", "В", ... instead of Latin letters.
\newcommand{\KNU@ukrappendixletter}[1]{%
  \ifcase#1\or А\or Б\or В\or Г\or Д\or Е\or Ж\or З\or И\or К\or Л\or М\or Н\or П\or Р\or С\or Т\or У\or Ф\or Х\or Ц\or Ш\or Ю\or Я\else \Alph{section}\fi
}

\newcommand{\KNUAppendixLetters}{%
  \renewcommand{\thesection}{\KNU@ukrappendixletter{\value{section}}}%
  \renewcommand{\theHsection}{appendix.\arabic{section}}%
}

\newcommand{\ukrappendixletter}[1]{\KNU@ukrappendixletter{#1}}

% -----------------------------------------------------------------------------
% Names of structural elements
% -----------------------------------------------------------------------------
\renewcommand{\contentsname}{ЗМІСТ}
\renewcommand{\refname}{ПЕРЕЛІК ДЖЕРЕЛ ПОСИЛАННЯ}

% -----------------------------------------------------------------------------
% Figures, tables, equations
% -----------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{caption}
\RequirePackage{chngcntr}
\RequirePackage{float}
\RequirePackage{lastpage}
\RequirePackage{totcount}

% Numbering within sections: Figure 2.1, Table 2.1, Formula (2.1)
\counterwithin{figure}{section}
\counterwithin{table}{section}
\counterwithin{equation}{section}

\renewcommand{\figurename}{Рисунок}
\renewcommand{\tablename}{Таблиця}

\DeclareCaptionLabelSeparator{knudash}{~---~}

\captionsetup{
  font=normalsize,
  labelfont=normalfont,
  labelsep=knudash
}

\captionsetup[figure]{
  name=Рисунок,
  justification=centering,
  singlelinecheck=true,
  position=bottom,
  skip=\baselineskip
}

\captionsetup[table]{
  name=Таблиця,
  justification=raggedright,
  singlelinecheck=false,
  position=top,
  skip=\baselineskip
}

\makeatletter
\def\KNU@table@here{\@float{table}[H]}
\def\KNU@table@ignore[#1]{\KNU@table@here}
\renewcommand{\table}{\@ifnextchar[{\KNU@table@ignore}{\KNU@table@here}}
\makeatother

% -----------------------------------------------------------------------------
% Lists: first-level bullet list as dash; compact but readable spacing
% -----------------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist[itemize,1]{label=—,leftmargin=2\parindent,itemsep=0pt,topsep=0pt,parsep=0pt}
\setlist[itemize,2]{label=—,leftmargin=2\parindent,itemsep=0pt,topsep=0pt,parsep=0pt}
\setlist[enumerate]{leftmargin=2\parindent,itemsep=0pt,topsep=0pt,parsep=0pt}

% -----------------------------------------------------------------------------
% URLs and hyperlinks
% -----------------------------------------------------------------------------
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{url}
\urlstyle{same}

% -----------------------------------------------------------------------------
% Verbatim code blocks and source-file inclusion
% -----------------------------------------------------------------------------
\RequirePackage{xcolor}
\RequirePackage{fvextra}

\DefineVerbatimEnvironment{KNUCodeBlock}{Verbatim}{
  breaklines=true,
  breaksymbolleft={},
  fontsize=\footnotesize,
  frame=single,
  rulecolor=\color{black}
}

\newcommand{\KNUCodeFile}[1]{%
  \VerbatimInput[
    breaklines=true,
    breaksymbolleft={},
    fontsize=\footnotesize,
    frame=single,
    rulecolor=\color{black}
  ]{#1}%
}

\DefineVerbatimEnvironment{CodeBlock}{Verbatim}{
  breaklines=true,
  breaksymbolleft={},
  fontsize=\footnotesize,
  frame=single,
  rulecolor=\color{black}
}
\newcommand{\CodeFile}[1]{\KNUCodeFile{#1}}

% -----------------------------------------------------------------------------
% Table of contents formatting
% -----------------------------------------------------------------------------
\RequirePackage{tocloft}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{2\baselineskip}
\setlength{\cftbeforesecskip}{0pt}
\setlength{\cftbeforesubsecskip}{0pt}
\renewcommand{\cfttoctitlefont}{\hfill\normalfont\normalsize\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}

% -----------------------------------------------------------------------------
% Useful environments / commands
% -----------------------------------------------------------------------------
\RequirePackage{keyval}

\makeatletter
